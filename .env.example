# ===== LLM =====
# Default model for the crew. Override per agent in agents.yaml if needed.
MODEL=groq/llama-3.3-70b-versatile

# Per-agent overrides (optional). Falls back to MODEL if unset.
RESEARCHER_LLM=groq/llama-3.3-70b-versatile
PLANNER_LLM=groq/llama-3.3-70b-versatile
WRITER_LLM=groq/llama-3.3-70b-versatile

# ===== LLM API keys (set at least one) =====
GROQ_API_KEY=your-groq-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ===== Web research (optional but recommended) =====
# Free tier: https://serper.dev (2,500 queries)
SERPER_API_KEY=your-serper-key

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./runs.db
OUTPUT_DIR=./output

# Comma-separated list of extra CORS origins (e.g. your deployed UI URL).
# EXTRA_CORS_ORIGINS=https://research-blog-ui.onrender.com
